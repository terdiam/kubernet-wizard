---
source: crates/kw-render/tests/render.rs
expression: "file(Preset::ProductionOnPrem, \"ansible/site.yml\")"
---
# Generated by kubernet-wizard: full cluster bootstrap.
# Run: ansible-playbook site.yml
- name: Prepare all nodes
  hosts: k8s_cluster
  become: true
  roles:
    - prereq
    - tuning
    - containerd

- name: Bootstrap first control plane
  hosts: control_plane[0]
  become: true
  vars:
    kw_first_cp: true
  roles:
    - cp_endpoint_kubevip
    - distro_kubeadm

- name: Join remaining control planes
  hosts: control_plane[1:]
  become: true
  serial: 1
  vars:
    kw_first_cp: false
  roles:
    - cp_endpoint_kubevip
    - distro_kubeadm

- name: Join workers
  hosts: workers
  become: true
  roles:
    - distro_kubeadm

- name: Cluster add-ons
  hosts: control_plane[0]
  become: true
  roles:
    - helm_bootstrap
    - cni_cilium
    - service_lb_metallb
    - ingress
    - gitops_argocd

- name: Fetch kubeconfig
  hosts: control_plane[0]
  become: true
  roles:
    - kubeconfig

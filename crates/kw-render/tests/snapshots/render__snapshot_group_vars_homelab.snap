---
source: crates/kw-render/tests/render.rs
expression: "file(Preset::Homelab, \"ansible/group_vars/all.yml\")"
---
# Generated by kubernet-wizard from cluster.yaml — edit cluster.yaml, then regenerate.
kw_cluster_name: homelab
kw_distro: k3s
kw_version: "v1.34.2+k3s1"
kw_os_family: debian
kw_kubeconfig: /etc/rancher/k3s/k3s.yaml
kw_kubectl: /usr/local/bin/kubectl
kw_manifests_dir: /var/lib/rancher/k3s/server/manifests
kw_static_pods_dir: 
kw_ha: true
kw_workers_count: 2

# Control-plane endpoint (stable from day one so single CP can become HA)
kw_endpoint_mode: kube_vip
kw_endpoint_host: "192.168.1.100"
kw_api_port: 6443
kw_vip: "192.168.1.100"
kw_vip_interface: "eth0"
kw_tls_sans_static: ["192.168.1.100"]
kw_tls_sans: "{{ (kw_tls_sans_static + [kw_endpoint_host]) | unique }}"

# Service load balancer
kw_service_lb: metallb
kw_lb_advertisement: l2
kw_lb_pool: "192.168.1.240-192.168.1.250"

# Network
kw_cni: cilium
kw_pod_cidr: "10.42.0.0/16"
kw_service_cidr: "10.43.0.0/16"
kw_cluster_dns: "10.43.0.10"
kw_cluster_domain: cluster.local
kw_kube_proxy: iptables
kw_mtu: 0

# Ingress (empty chart = none / bundled by distro)
kw_ingress: traefik
kw_ingress_chart: {"name":"","repo":"","chart":"","namespace":"","version":"","values":[],"manifest":"","gateway_api":false}

# Add-ons installed by Helm (empty when GitOps manages them)
kw_addons: [{"name":"metrics-server","repo":"https://kubernetes-sigs.github.io/metrics-server/","chart":"metrics-server","namespace":"kube-system","version":"","values":["args[0]=--kubelet-insecure-tls"],"manifest":"","gateway_api":false},{"name":"cert-manager","repo":"https://charts.jetstack.io","chart":"cert-manager","namespace":"cert-manager","version":"","values":["crds.enabled=true"],"manifest":"","gateway_api":false}]

# GitOps
kw_gitops_tool: none
kw_gitops_repo: ""
kw_gitops_branch: ""
kw_gitops_path: "clusters/homelab"

# Tuning profile: minimal
kw_tuning_profile: minimal
kw_sysctl: {"fs.file-max":"2097152","fs.inotify.max_user_instances":"8192","fs.inotify.max_user_watches":"524288","kernel.panic":"10","kernel.panic_on_oops":"1","net.core.netdev_max_backlog":"4096","net.core.somaxconn":"4096","net.ipv4.ip_local_port_range":"1024 65535","net.ipv4.tcp_max_syn_backlog":"4096","net.ipv4.tcp_tw_reuse":"1","net.netfilter.nf_conntrack_max":"131072","vm.max_map_count":"262144","vm.overcommit_memory":"1","vm.swappiness":"0"}
kw_disable_services: ["snapd","snapd.socket","ModemManager","bluetooth","cups","avahi-daemon","multipathd","apport","motd-news.timer","packagekit"]
kw_kubelet:
  system_reserved: "cpu=100m,memory=409Mi"
  kube_reserved: "cpu=100m,memory=614Mi"
  eviction_hard: "memory.available<100Mi,nodefs.available<10%,imagefs.available<15%"
  max_pods: 110
  image_gc_high: 75
  image_gc_low: 60
  cpu_manager_policy: none
  serialize_image_pulls: false

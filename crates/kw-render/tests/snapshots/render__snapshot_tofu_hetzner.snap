---
source: crates/kw-render/tests/render.rs
expression: "file(Preset::CloudHetzner, \"tofu/hetzner/main.tf\")"
---
# Generated by kubernet-wizard: Hetzner Cloud infrastructure for "cloud".
terraform {
  required_providers {
    hcloud = { source = "hetznercloud/hcloud", version = "~> 1.50" }
    local  = { source = "hashicorp/local", version = "~> 2.5" }
  }
}

variable "hcloud_token" {
  type      = string
  sensitive = true
}

variable "ssh_public_key" {
  type    = string
  default = "~/.ssh/id_ed25519.pub"
}

provider "hcloud" {
  token = var.hcloud_token
}

locals {
  name     = "cloud"
  location = "fsn1"
  image    = "ubuntu-24.04"
}

resource "hcloud_ssh_key" "kw" {
  name       = "${local.name}-kw"
  public_key = file(pathexpand(var.ssh_public_key))
}

resource "hcloud_network" "net" {
  name     = local.name
  ip_range = "10.0.0.0/16"
}

resource "hcloud_network_subnet" "nodes" {
  network_id   = hcloud_network.net.id
  type         = "cloud"
  network_zone = "eu-central"
  ip_range     = cidrsubnet(hcloud_network.net.ip_range, 8, 1)
}

resource "hcloud_server" "cp" {
  count       = 3
  name        = "${local.name}-cp-${count.index + 1}"
  server_type = "cpx21"
  image       = local.image
  location    = local.location
  ssh_keys    = [hcloud_ssh_key.kw.id]
  labels      = { cluster = local.name, role = "control-plane" }
  network {
    network_id = hcloud_network.net.id
  }
  depends_on = [hcloud_network_subnet.nodes]
}

resource "hcloud_server" "worker" {
  count       = 2
  name        = "${local.name}-worker-${count.index + 1}"
  server_type = "cpx31"
  image       = local.image
  location    = local.location
  ssh_keys    = [hcloud_ssh_key.kw.id]
  labels      = { cluster = local.name, role = "worker" }
  network {
    network_id = hcloud_network.net.id
  }
  depends_on = [hcloud_network_subnet.nodes]
}

resource "hcloud_load_balancer" "api" {
  name               = "${local.name}-api"
  load_balancer_type = "lb11"
  location           = local.location
}

resource "hcloud_load_balancer_network" "api" {
  load_balancer_id = hcloud_load_balancer.api.id
  network_id       = hcloud_network.net.id
}

resource "hcloud_load_balancer_target" "cp" {
  type             = "label_selector"
  load_balancer_id = hcloud_load_balancer.api.id
  label_selector   = "cluster=${local.name},role=control-plane"
  use_private_ip   = true
  depends_on       = [hcloud_load_balancer_network.api]
}

resource "hcloud_load_balancer_service" "api" {
  for_each         = toset(["6443", "9345"])
  load_balancer_id = hcloud_load_balancer.api.id
  protocol         = "tcp"
  listen_port      = tonumber(each.value)
  destination_port = tonumber(each.value)
}

resource "local_file" "inventory" {
  filename        = "${path.module}/../../ansible/inventory.yml"
  file_permission = "0644"
  content = yamlencode({
    all = {
      vars = { kw_endpoint_host = hcloud_load_balancer.api.ipv4 }
      children = {
        k8s_cluster = {
          children = {
            control_plane = { hosts = { for s in hcloud_server.cp : s.name => { ansible_host = s.ipv4_address, ansible_user = "root" } } }
            workers       = { hosts = { for s in hcloud_server.worker : s.name => { ansible_host = s.ipv4_address, ansible_user = "root" } } }
          }
        }
      }
    }
  })
}

output "control_planes" {
  value = { for s in hcloud_server.cp : s.name => s.ipv4_address }
}

output "api_endpoint" {
  value = hcloud_load_balancer.api.ipv4
}

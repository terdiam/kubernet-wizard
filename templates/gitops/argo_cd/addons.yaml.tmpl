# Generated by kubernet-wizard. Push to {{ spec.gitops.repo_url }} under {{ gitops_path }}/
{%- for a in gitops_addons %}
---
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ a.name }}
  namespace: argocd
spec:
  project: default
  source:
    repoURL: {{ a.repo }}
    chart: {{ a.chart }}
    targetRevision: "{{ a.version or "*" }}"
    helm:
      valuesObject: {{ a.values_obj | tojson }}
  destination:
    server: https://kubernetes.default.svc
    namespace: {{ a.namespace }}
  syncPolicy:
    automated: { prune: true, selfHeal: true }
    syncOptions: [CreateNamespace=true, ServerSideApply=true]
{%- endfor %}

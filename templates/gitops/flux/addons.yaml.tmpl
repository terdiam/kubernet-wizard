# Generated by kubernet-wizard. Push to {{ spec.gitops.repo_url }} under {{ gitops_path }}/
{%- for a in gitops_addons %}
---
apiVersion: v1
kind: Namespace
metadata: { name: {{ a.namespace }} }
---
apiVersion: source.toolkit.fluxcd.io/v1
kind: HelmRepository
metadata: { name: {{ a.name }}, namespace: flux-system }
spec: { interval: 1h, url: {{ a.repo }} }
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata: { name: {{ a.name }}, namespace: {{ a.namespace }} }
spec:
  interval: 10m
  chart:
    spec:
      chart: {{ a.chart }}
      version: "{{ a.version or "*" }}"
      sourceRef: { kind: HelmRepository, name: {{ a.name }}, namespace: flux-system }
  install: { crds: CreateReplace }
  upgrade: { crds: CreateReplace }
  values: {{ a.values_obj | tojson }}
{%- endfor %}

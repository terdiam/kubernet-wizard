# Generated by kubernet-wizard: DigitalOcean infrastructure for "{{ spec.name }}".
# {{ tofu.hint }}
terraform {
  required_providers {
    digitalocean = { source = "digitalocean/digitalocean", version = "~> 2.40" }
    local        = { source = "hashicorp/local", version = "~> 2.5" }
  }
}

variable "ssh_public_key" {
  type    = string
  default = "~/.ssh/id_ed25519.pub"
}

variable "admin_cidrs" {
  description = "Networks allowed to reach SSH and the Kubernetes API."
  type        = list(string)
  default     = ["0.0.0.0/0", "::/0"]
}

# Token is read from DIGITALOCEAN_TOKEN.
provider "digitalocean" {}

locals {
  name     = "{{ spec.name }}"
  region   = "{{ tofu.region }}"
  image    = "{{ tofu.image }}"
  lb_ports = {{ tofu.lb_ports }}
}

resource "digitalocean_ssh_key" "kw" {
  name       = "${local.name}-kw"
  public_key = file(pathexpand(var.ssh_public_key))
}

resource "digitalocean_vpc" "net" {
  name     = local.name
  region   = local.region
  ip_range = {% if spec.network.node_cidr %}"{{ spec.network.node_cidr }}"{% else %}null{% endif %}
}

resource "digitalocean_tag" "cluster" {
  name = local.name
}

resource "digitalocean_tag" "cp" {
  name = "${local.name}-cp"
}

resource "digitalocean_droplet" "cp" {
  count    = {{ spec.topology.control_planes }}
  name     = "${local.name}-cp-${count.index + 1}"
  region   = local.region
  size     = "{{ tofu.cp_size }}"
  image    = local.image
  vpc_uuid = digitalocean_vpc.net.id
  ssh_keys = [digitalocean_ssh_key.kw.fingerprint]
  tags     = [digitalocean_tag.cluster.id, digitalocean_tag.cp.id]
  lifecycle {
    ignore_changes = [image]
  }
}

resource "digitalocean_droplet" "worker" {
  count    = {{ spec.topology.workers }}
  name     = "${local.name}-worker-${count.index + 1}"
  region   = local.region
  size     = "{{ tofu.worker_size }}"
  image    = local.image
  vpc_uuid = digitalocean_vpc.net.id
  ssh_keys = [digitalocean_ssh_key.kw.fingerprint]
  tags     = [digitalocean_tag.cluster.id]
  lifecycle {
    ignore_changes = [image]
  }
}
{% if spec.endpoint.mode == "cloud_lb" %}
resource "digitalocean_loadbalancer" "api" {
  name        = "${local.name}-api"
  region      = local.region
  vpc_uuid    = digitalocean_vpc.net.id
  droplet_tag = digitalocean_tag.cp.id
  dynamic "forwarding_rule" {
    for_each = local.lb_ports
    content {
      entry_port      = forwarding_rule.value
      entry_protocol  = "tcp"
      target_port     = forwarding_rule.value
      target_protocol = "tcp"
    }
  }
  healthcheck {
    port     = local.lb_ports[0]
    protocol = "tcp"
  }
  depends_on = [digitalocean_droplet.cp]
}
{% endif %}
resource "digitalocean_firewall" "nodes" {
  name = "${local.name}-nodes"
  tags = [digitalocean_tag.cluster.id]

  inbound_rule {
    protocol         = "tcp"
    port_range       = "22"
    source_addresses = var.admin_cidrs
  }
  dynamic "inbound_rule" {
    for_each = local.lb_ports
    content {
      protocol                  = "tcp"
      port_range                = tostring(inbound_rule.value)
      source_addresses          = var.admin_cidrs
      source_tags               = [digitalocean_tag.cluster.id]
      source_load_balancer_uids = {% if spec.endpoint.mode == "cloud_lb" %}[digitalocean_loadbalancer.api.id]{% else %}[]{% endif %}
    }
  }
  dynamic "inbound_rule" {
    for_each = ["80", "443"]
    content {
      protocol         = "tcp"
      port_range       = inbound_rule.value
      source_addresses = ["0.0.0.0/0", "::/0"]
    }
  }
  dynamic "inbound_rule" {
    for_each = ["tcp", "udp"]
    content {
      protocol    = inbound_rule.value
      port_range  = "1-65535"
      source_tags = [digitalocean_tag.cluster.id]
    }
  }
  inbound_rule {
    protocol         = "icmp"
    source_addresses = ["0.0.0.0/0", "::/0"]
  }
  dynamic "outbound_rule" {
    for_each = ["tcp", "udp"]
    content {
      protocol              = outbound_rule.value
      port_range            = "1-65535"
      destination_addresses = ["0.0.0.0/0", "::/0"]
    }
  }
  outbound_rule {
    protocol              = "icmp"
    destination_addresses = ["0.0.0.0/0", "::/0"]
  }
}

resource "local_file" "inventory" {
  filename        = "${path.module}/../../ansible/inventory.yml"
  file_permission = "0644"
  content = yamlencode({
    all = {
      {%- if spec.endpoint.mode == "cloud_lb" %}
      vars = { kw_endpoint_host = digitalocean_loadbalancer.api.ip }
      {%- endif %}
      children = {
        k8s_cluster = {
          children = {
            control_plane = { hosts = { for d in digitalocean_droplet.cp : d.name => { ansible_host = d.ipv4_address, ansible_user = "root" } } }
            workers       = { hosts = { for d in digitalocean_droplet.worker : d.name => { ansible_host = d.ipv4_address, ansible_user = "root" } } }
          }
        }
      }
    }
  })
}

output "control_planes" {
  value = { for d in digitalocean_droplet.cp : d.name => d.ipv4_address }
}
{% if spec.endpoint.mode == "cloud_lb" %}
output "api_endpoint" {
  value = digitalocean_loadbalancer.api.ip
}
{% endif %}

# Generated by kubernet-wizard: Proxmox VE infrastructure for "{{ spec.name }}".
# {{ tofu.hint }}
# VMs get their address by DHCP; reserve leases so node IPs stay stable.
terraform {
  required_providers {
    proxmox = { source = "bpg/proxmox", version = "~> 0.70" }
    local   = { source = "hashicorp/local", version = "~> 2.5" }
  }
}

variable "ssh_public_key" {
  type    = string
  default = "~/.ssh/id_ed25519.pub"
}

variable "bridge" {
  description = "Network bridge for the VMs."
  type        = string
  default     = "vmbr0"
}

variable "datastore" {
  description = "Datastore for the cloned disks."
  type        = string
  default     = "local-lvm"
}

# Endpoint and token are read from PROXMOX_VE_ENDPOINT / PROXMOX_VE_API_TOKEN
# (PROXMOX_VE_INSECURE=true for self-signed certificates).
provider "proxmox" {}

locals {
  name        = "{{ spec.name }}"
  node        = "{{ tofu.region }}"
  template_id = {{ tofu.image }}
  ssh_key     = trimspace(file(pathexpand(var.ssh_public_key)))
  nodes = merge(
    { for i in range({{ spec.topology.control_planes }}) : "${local.name}-cp-${i + 1}" => { role = "control-plane", size = split("x", "{{ tofu.cp_size }}"), disk = 40 } },
    { for i in range({{ spec.topology.workers }}) : "${local.name}-worker-${i + 1}" => { role = "worker", size = split("x", "{{ tofu.worker_size }}"), disk = 60 } },
  )
  # First non-loopback IPv4 reported by the guest agent.
  ip = { for k, vm in proxmox_virtual_environment_vm.node : k => [for a in flatten(vm.ipv4_addresses) : a if a != "127.0.0.1"][0] }
}

resource "proxmox_virtual_environment_vm" "node" {
  for_each        = local.nodes
  name            = each.key
  node_name       = local.node
  tags            = [local.name, each.value.role]
  stop_on_destroy = true

  clone {
    vm_id = local.template_id
    full  = true
  }
  agent {
    enabled = true
  }
  cpu {
    cores = tonumber(each.value.size[0])
    type  = "host"
  }
  memory {
    dedicated = tonumber(each.value.size[1])
  }
  disk {
    datastore_id = var.datastore
    interface    = "scsi0"
    size         = each.value.disk
  }
  network_device {
    bridge = var.bridge
  }
  initialization {
    datastore_id = var.datastore
    ip_config {
      ipv4 {
        address = "dhcp"
      }
    }
    user_account {
      username = "kw"
      keys     = [local.ssh_key]
    }
  }
}

resource "local_file" "inventory" {
  filename        = "${path.module}/../../ansible/inventory.yml"
  file_permission = "0644"
  content = yamlencode({
    all = {
      children = {
        k8s_cluster = {
          children = {
            control_plane = { hosts = { for k, v in local.nodes : k => { ansible_host = local.ip[k], ansible_user = "kw" } if v.role == "control-plane" } }
            workers       = { hosts = { for k, v in local.nodes : k => { ansible_host = local.ip[k], ansible_user = "kw" } if v.role == "worker" } }
          }
        }
      }
    }
  })
}

output "control_planes" {
  value = { for k, v in local.nodes : k => local.ip[k] if v.role == "control-plane" }
}

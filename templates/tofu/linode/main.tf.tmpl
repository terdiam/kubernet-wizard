# Generated by kubernet-wizard: Akamai / Linode infrastructure for "{{ spec.name }}".
# {{ tofu.hint }}
terraform {
  required_providers {
    linode = { source = "linode/linode", version = "~> 3.0" }
    local  = { source = "hashicorp/local", version = "~> 2.5" }
  }
}

variable "ssh_public_key" {
  type    = string
  default = "~/.ssh/id_ed25519.pub"
}

variable "admin_cidrs" {
  description = "Networks allowed to reach SSH and the Kubernetes API."
  type        = list(string)
  default     = ["0.0.0.0/0"]
}

# Token is read from LINODE_TOKEN.
provider "linode" {}

locals {
  name     = "{{ spec.name }}"
  region   = "{{ tofu.region }}"
  image    = "{{ tofu.image }}"
  lb_ports = {{ tofu.lb_ports }}
  ssh_key  = trimspace(file(pathexpand(var.ssh_public_key)))
  all      = concat(linode_instance.cp, linode_instance.worker)
  node_ips = concat([for n in local.all : "${n.ip_address}/32"], [for n in local.all : "${n.private_ip_address}/32"])
}

resource "linode_instance" "cp" {
  count           = {{ spec.topology.control_planes }}
  label           = "${local.name}-cp-${count.index + 1}"
  region          = local.region
  type            = "{{ tofu.cp_size }}"
  image           = local.image
  authorized_keys = [local.ssh_key]
  private_ip      = true
  tags            = [local.name, "control-plane"]
  lifecycle {
    ignore_changes = [image]
  }
}

resource "linode_instance" "worker" {
  count           = {{ spec.topology.workers }}
  label           = "${local.name}-worker-${count.index + 1}"
  region          = local.region
  type            = "{{ tofu.worker_size }}"
  image           = local.image
  authorized_keys = [local.ssh_key]
  private_ip      = true
  tags            = [local.name, "worker"]
  lifecycle {
    ignore_changes = [image]
  }
}

resource "linode_firewall" "nodes" {
  label           = "${substr(local.name, 0, 25)}-nodes"
  inbound_policy  = "DROP"
  outbound_policy = "ACCEPT"
  linodes         = local.all[*].id

  inbound {
    label    = "ssh"
    action   = "ACCEPT"
    protocol = "TCP"
    ports    = "22"
    ipv4     = var.admin_cidrs
  }
  inbound {
    label    = "kube-api"
    action   = "ACCEPT"
    protocol = "TCP"
    ports    = join(",", [for p in local.lb_ports : tostring(p)])
    # 192.168.255.0/24: NodeBalancer back-end connections.
    ipv4 = distinct(concat(var.admin_cidrs, local.node_ips, ["192.168.255.0/24"]))
  }
  inbound {
    label    = "ingress"
    action   = "ACCEPT"
    protocol = "TCP"
    ports    = "80,443"
    ipv4     = ["0.0.0.0/0"]
    ipv6     = ["::/0"]
  }
  inbound {
    label    = "cluster-tcp"
    action   = "ACCEPT"
    protocol = "TCP"
    ipv4     = local.node_ips
  }
  inbound {
    label    = "cluster-udp"
    action   = "ACCEPT"
    protocol = "UDP"
    ipv4     = local.node_ips
  }
  inbound {
    label    = "icmp"
    action   = "ACCEPT"
    protocol = "ICMP"
    ipv4     = ["0.0.0.0/0"]
  }
}
{% if spec.endpoint.mode == "cloud_lb" %}
resource "linode_nodebalancer" "api" {
  label  = "${substr(local.name, 0, 28)}-api"
  region = local.region
}

resource "linode_nodebalancer_config" "api" {
  for_each        = toset([for p in local.lb_ports : tostring(p)])
  nodebalancer_id = linode_nodebalancer.api.id
  port            = tonumber(each.value)
  protocol        = "tcp"
  check           = "connection"
  algorithm       = "roundrobin"
}

resource "linode_nodebalancer_node" "cp" {
  for_each        = { for pair in setproduct([for p in local.lb_ports : tostring(p)], range({{ spec.topology.control_planes }})) : "${pair[0]}-${pair[1]}" => pair }
  nodebalancer_id = linode_nodebalancer.api.id
  config_id       = linode_nodebalancer_config.api[each.value[0]].id
  label           = "cp-${each.value[1] + 1}"
  address         = "${linode_instance.cp[each.value[1]].private_ip_address}:${each.value[0]}"
  mode            = "accept"
}
{% endif %}
resource "local_file" "inventory" {
  filename        = "${path.module}/../../ansible/inventory.yml"
  file_permission = "0644"
  content = yamlencode({
    all = {
      {%- if spec.endpoint.mode == "cloud_lb" %}
      vars = { kw_endpoint_host = linode_nodebalancer.api.ipv4 }
      {%- endif %}
      children = {
        k8s_cluster = {
          children = {
            control_plane = { hosts = { for n in linode_instance.cp : n.label => { ansible_host = n.ip_address, ansible_user = "root" } } }
            workers       = { hosts = { for n in linode_instance.worker : n.label => { ansible_host = n.ip_address, ansible_user = "root" } } }
          }
        }
      }
    }
  })
}

output "control_planes" {
  value = { for n in linode_instance.cp : n.label => n.ip_address }
}
{% if spec.endpoint.mode == "cloud_lb" %}
output "api_endpoint" {
  value = linode_nodebalancer.api.ipv4
}
{% endif %}

# Generated by kubernet-wizard: AWS infrastructure for "{{ spec.name }}".
# {{ tofu.hint }}
terraform {
  required_providers {
    aws   = { source = "hashicorp/aws", version = "~> 6.0" }
    local = { source = "hashicorp/local", version = "~> 2.5" }
  }
}

variable "ssh_public_key" {
  type    = string
  default = "~/.ssh/id_ed25519.pub"
}

variable "admin_cidrs" {
  description = "Networks allowed to reach SSH and the Kubernetes API."
  type        = list(string)
  default     = ["0.0.0.0/0"]
}

provider "aws" {
  region = local.region
  default_tags {
    tags = { cluster = local.name, managed-by = "kubernet-wizard" }
  }
}

locals {
  name     = "{{ spec.name }}"
  region   = "{{ tofu.region }}"
  image    = "{{ tofu.image }}"
  lb_ports = {{ tofu.lb_ports }}
  vpc_cidr = "{{ spec.network.node_cidr or "10.0.0.0/16" }}"
  azs      = slice(data.aws_availability_zones.up.names, 0, min(3, length(data.aws_availability_zones.up.names)))
  # Same login user on every image (Ubuntu, Debian, RHEL family).
  cloud_init = <<-EOT
    #cloud-config
    users:
      - name: kw
        sudo: ALL=(ALL) NOPASSWD:ALL
        shell: /bin/bash
        ssh_authorized_keys:
          - ${trimspace(file(pathexpand(var.ssh_public_key)))}
  EOT
}

data "aws_availability_zones" "up" {
  state = "available"
}

# Image may be an AMI id or a name pattern from a trusted publisher.
data "aws_ami" "os" {
  count       = startswith(local.image, "ami-") ? 0 : 1
  most_recent = true
  # Canonical, Debian, Red Hat, Rocky, Alma
  owners = ["099720109477", "136693071363", "309956199498", "792107900819", "764336703387"]
  filter {
    name   = "name"
    values = [local.image]
  }
  filter {
    name   = "architecture"
    values = ["x86_64"]
  }
}

resource "aws_vpc" "net" {
  cidr_block           = local.vpc_cidr
  enable_dns_hostnames = true
  tags                 = { Name = local.name }
}

resource "aws_internet_gateway" "gw" {
  vpc_id = aws_vpc.net.id
}

resource "aws_subnet" "nodes" {
  count                   = length(local.azs)
  vpc_id                  = aws_vpc.net.id
  availability_zone       = local.azs[count.index]
  cidr_block              = cidrsubnet(local.vpc_cidr, 8, count.index + 1)
  map_public_ip_on_launch = true
  tags                    = { Name = "${local.name}-${local.azs[count.index]}" }
}

resource "aws_route_table" "public" {
  vpc_id = aws_vpc.net.id
  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.gw.id
  }
}

resource "aws_route_table_association" "nodes" {
  count          = length(aws_subnet.nodes)
  subnet_id      = aws_subnet.nodes[count.index].id
  route_table_id = aws_route_table.public.id
}

resource "aws_security_group" "nodes" {
  name   = "${local.name}-nodes"
  vpc_id = aws_vpc.net.id

  ingress {
    description = "cluster internal"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = [local.vpc_cidr]
  }
  ingress {
    description = "ssh"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = var.admin_cidrs
  }
  dynamic "ingress" {
    for_each = local.lb_ports
    content {
      description = "kubernetes api"
      from_port   = ingress.value
      to_port     = ingress.value
      protocol    = "tcp"
      cidr_blocks = var.admin_cidrs
    }
  }
  dynamic "ingress" {
    for_each = [80, 443]
    content {
      description = "ingress"
      from_port   = ingress.value
      to_port     = ingress.value
      protocol    = "tcp"
      cidr_blocks = ["0.0.0.0/0"]
    }
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_instance" "cp" {
  count                  = {{ spec.topology.control_planes }}
  ami                    = startswith(local.image, "ami-") ? local.image : data.aws_ami.os[0].id
  instance_type          = "{{ tofu.cp_size }}"
  subnet_id              = aws_subnet.nodes[count.index % length(aws_subnet.nodes)].id
  vpc_security_group_ids = [aws_security_group.nodes.id]
  user_data              = local.cloud_init
  source_dest_check      = false
  metadata_options {
    http_tokens = "required"
  }
  root_block_device {
    volume_size = 40
    volume_type = "gp3"
  }
  tags = { Name = "${local.name}-cp-${count.index + 1}", role = "control-plane" }
  lifecycle {
    ignore_changes = [ami]
  }
}

resource "aws_instance" "worker" {
  count                  = {{ spec.topology.workers }}
  ami                    = startswith(local.image, "ami-") ? local.image : data.aws_ami.os[0].id
  instance_type          = "{{ tofu.worker_size }}"
  subnet_id              = aws_subnet.nodes[count.index % length(aws_subnet.nodes)].id
  vpc_security_group_ids = [aws_security_group.nodes.id]
  user_data              = local.cloud_init
  source_dest_check      = false
  metadata_options {
    http_tokens = "required"
  }
  root_block_device {
    volume_size = 60
    volume_type = "gp3"
  }
  tags = { Name = "${local.name}-worker-${count.index + 1}", role = "worker" }
  lifecycle {
    ignore_changes = [ami]
  }
}
{% if spec.endpoint.mode == "cloud_lb" %}
resource "aws_lb" "api" {
  name               = "${substr(local.name, 0, 28)}-api"
  load_balancer_type = "network"
  subnets            = aws_subnet.nodes[*].id
}

resource "aws_lb_target_group" "api" {
  for_each = toset([for p in local.lb_ports : tostring(p)])
  name     = "${substr(local.name, 0, 26)}-${each.value}"
  port     = tonumber(each.value)
  protocol = "TCP"
  vpc_id   = aws_vpc.net.id
  # Nodes reach the API through the NLB; client IP preservation would break hairpin traffic.
  preserve_client_ip = "false"
  health_check {
    protocol = "TCP"
  }
}

resource "aws_lb_listener" "api" {
  for_each          = aws_lb_target_group.api
  load_balancer_arn = aws_lb.api.arn
  port              = each.value.port
  protocol          = "TCP"
  default_action {
    type             = "forward"
    target_group_arn = each.value.arn
  }
}

resource "aws_lb_target_group_attachment" "cp" {
  for_each         = { for pair in setproduct([for p in local.lb_ports : tostring(p)], range({{ spec.topology.control_planes }})) : "${pair[0]}-${pair[1]}" => pair }
  target_group_arn = aws_lb_target_group.api[each.value[0]].arn
  target_id        = aws_instance.cp[each.value[1]].id
  port             = tonumber(each.value[0])
}
{% endif %}
resource "local_file" "inventory" {
  filename        = "${path.module}/../../ansible/inventory.yml"
  file_permission = "0644"
  content = yamlencode({
    all = {
      {%- if spec.endpoint.mode == "cloud_lb" %}
      vars = { kw_endpoint_host = aws_lb.api.dns_name }
      {%- endif %}
      children = {
        k8s_cluster = {
          children = {
            control_plane = { hosts = { for i in aws_instance.cp : i.tags.Name => { ansible_host = i.public_ip, ansible_user = "kw" } } }
            workers       = { hosts = { for i in aws_instance.worker : i.tags.Name => { ansible_host = i.public_ip, ansible_user = "kw" } } }
          }
        }
      }
    }
  })
}

output "control_planes" {
  value = { for i in aws_instance.cp : i.tags.Name => i.public_ip }
}
{% if spec.endpoint.mode == "cloud_lb" %}
output "api_endpoint" {
  value = aws_lb.api.dns_name
}
{% endif %}

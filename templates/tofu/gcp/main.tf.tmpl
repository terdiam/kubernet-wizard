# Generated by kubernet-wizard: Google Cloud infrastructure for "{{ spec.name }}".
# {{ tofu.hint }}
terraform {
  required_providers {
    google = { source = "hashicorp/google", version = "~> 7.0" }
    local  = { source = "hashicorp/local", version = "~> 2.5" }
  }
}

variable "project" {
  description = "Google Cloud project id."
  type        = string
}

variable "ssh_public_key" {
  type    = string
  default = "~/.ssh/id_ed25519.pub"
}

variable "admin_cidrs" {
  description = "Networks allowed to reach SSH and the Kubernetes API."
  type        = list(string)
  default     = ["0.0.0.0/0"]
}

provider "google" {
  project = var.project
  region  = local.region
  zone    = local.zone
}

locals {
  name     = "{{ spec.name }}"
  zone     = "{{ tofu.region }}"
  region   = join("-", slice(split("-", local.zone), 0, 2))
  image    = "{{ tofu.image }}"
  lb_ports = {{ tofu.lb_ports }}
  ssh_keys = "kw:${trimspace(file(pathexpand(var.ssh_public_key)))}"
  node_ips = [for i in concat(google_compute_instance.cp, google_compute_instance.worker) : "${i.network_interface[0].access_config[0].nat_ip}/32"]
}

resource "google_compute_network" "net" {
  name                    = local.name
  auto_create_subnetworks = false
}

resource "google_compute_subnetwork" "nodes" {
  name          = "${local.name}-nodes"
  network       = google_compute_network.net.id
  region        = local.region
  ip_cidr_range = "{{ spec.network.node_cidr or "10.0.0.0/16" }}"
}

resource "google_compute_firewall" "internal" {
  name          = "${local.name}-internal"
  network       = google_compute_network.net.id
  source_ranges = [google_compute_subnetwork.nodes.ip_cidr_range]
  target_tags   = [local.name]
  allow { protocol = "all" }
}

resource "google_compute_firewall" "ssh" {
  name          = "${local.name}-ssh"
  network       = google_compute_network.net.id
  source_ranges = var.admin_cidrs
  target_tags   = [local.name]
  allow {
    protocol = "tcp"
    ports    = ["22"]
  }
}

# Admin networks, nodes, and Google LB proxies / health checks.
resource "google_compute_firewall" "api" {
  name          = "${local.name}-api"
  network       = google_compute_network.net.id
  source_ranges = distinct(concat(var.admin_cidrs, local.node_ips, ["35.191.0.0/16", "130.211.0.0/22"]))
  target_tags   = ["${local.name}-cp"]
  allow {
    protocol = "tcp"
    ports    = [for p in local.lb_ports : tostring(p)]
  }
}

resource "google_compute_firewall" "ingress" {
  name          = "${local.name}-ingress"
  network       = google_compute_network.net.id
  source_ranges = ["0.0.0.0/0"]
  target_tags   = [local.name]
  allow {
    protocol = "tcp"
    ports    = ["80", "443"]
  }
}

resource "google_compute_instance" "cp" {
  count          = {{ spec.topology.control_planes }}
  name           = "${local.name}-cp-${count.index + 1}"
  machine_type   = "{{ tofu.cp_size }}"
  tags           = [local.name, "${local.name}-cp"]
  can_ip_forward = true
  labels         = { cluster = local.name, role = "control-plane" }
  metadata       = { ssh-keys = local.ssh_keys }
  boot_disk {
    initialize_params {
      image = local.image
      size  = 40
      type  = "pd-balanced"
    }
  }
  network_interface {
    subnetwork = google_compute_subnetwork.nodes.id
    access_config {}
  }
  shielded_instance_config {
    enable_secure_boot = true
  }
  lifecycle {
    ignore_changes = [boot_disk[0].initialize_params[0].image]
  }
}

resource "google_compute_instance" "worker" {
  count          = {{ spec.topology.workers }}
  name           = "${local.name}-worker-${count.index + 1}"
  machine_type   = "{{ tofu.worker_size }}"
  tags           = [local.name]
  can_ip_forward = true
  labels         = { cluster = local.name, role = "worker" }
  metadata       = { ssh-keys = local.ssh_keys }
  boot_disk {
    initialize_params {
      image = local.image
      size  = 60
      type  = "pd-balanced"
    }
  }
  network_interface {
    subnetwork = google_compute_subnetwork.nodes.id
    access_config {}
  }
  shielded_instance_config {
    enable_secure_boot = true
  }
  lifecycle {
    ignore_changes = [boot_disk[0].initialize_params[0].image]
  }
}
{% if spec.endpoint.mode == "cloud_lb" %}
# Proxy load balancer: unlike passthrough NLBs, control-plane nodes can reach
# the endpoint without being routed back to themselves (needed while joining).
resource "google_compute_instance_group" "cp" {
  name      = "${local.name}-cp"
  zone      = local.zone
  instances = google_compute_instance.cp[*].self_link
  dynamic "named_port" {
    for_each = local.lb_ports
    content {
      name = "p${named_port.value}"
      port = named_port.value
    }
  }
}

resource "google_compute_health_check" "api" {
  for_each = toset([for p in local.lb_ports : tostring(p)])
  name     = "${local.name}-${each.value}"
  tcp_health_check {
    port = tonumber(each.value)
  }
}

resource "google_compute_backend_service" "api" {
  for_each              = google_compute_health_check.api
  name                  = "${local.name}-${each.key}"
  protocol              = "TCP"
  port_name             = "p${each.key}"
  load_balancing_scheme = "EXTERNAL_MANAGED"
  timeout_sec           = 3600
  health_checks         = [each.value.id]
  backend {
    group           = google_compute_instance_group.cp.self_link
    balancing_mode  = "UTILIZATION"
    capacity_scaler = 1
  }
}

resource "google_compute_target_tcp_proxy" "api" {
  for_each        = google_compute_backend_service.api
  name            = "${local.name}-${each.key}"
  backend_service = each.value.id
}

resource "google_compute_global_address" "api" {
  name = "${local.name}-api"
}

resource "google_compute_global_forwarding_rule" "api" {
  for_each              = google_compute_target_tcp_proxy.api
  name                  = "${local.name}-${each.key}"
  ip_address            = google_compute_global_address.api.address
  port_range            = each.key
  target                = each.value.id
  load_balancing_scheme = "EXTERNAL_MANAGED"
}
{% endif %}
resource "local_file" "inventory" {
  filename        = "${path.module}/../../ansible/inventory.yml"
  file_permission = "0644"
  content = yamlencode({
    all = {
      {%- if spec.endpoint.mode == "cloud_lb" %}
      vars = { kw_endpoint_host = google_compute_global_address.api.address }
      {%- endif %}
      children = {
        k8s_cluster = {
          children = {
            control_plane = { hosts = { for i in google_compute_instance.cp : i.name => { ansible_host = i.network_interface[0].access_config[0].nat_ip, ansible_user = "kw" } } }
            workers       = { hosts = { for i in google_compute_instance.worker : i.name => { ansible_host = i.network_interface[0].access_config[0].nat_ip, ansible_user = "kw" } } }
          }
        }
      }
    }
  })
}

output "control_planes" {
  value = { for i in google_compute_instance.cp : i.name => i.network_interface[0].access_config[0].nat_ip }
}
{% if spec.endpoint.mode == "cloud_lb" %}
output "api_endpoint" {
  value = google_compute_global_address.api.address
}
{% endif %}

# Generated by kubernet-wizard: Azure infrastructure for "{{ spec.name }}".
# {{ tofu.hint }}
terraform {
  required_providers {
    azurerm = { source = "hashicorp/azurerm", version = "~> 4.0" }
    local   = { source = "hashicorp/local", version = "~> 2.5" }
  }
}

variable "ssh_public_key" {
  type    = string
  default = "~/.ssh/id_ed25519.pub"
}

variable "admin_cidrs" {
  description = "Networks allowed to reach SSH and the Kubernetes API."
  type        = list(string)
  default     = ["0.0.0.0/0"]
}

# Subscription is read from ARM_SUBSCRIPTION_ID.
provider "azurerm" {
  features {}
}

locals {
  name      = "{{ spec.name }}"
  location  = "{{ tofu.region }}"
  image     = split(":", "{{ tofu.image }}")
  lb_ports  = {{ tofu.lb_ports }}
  vnet_cidr = "{{ spec.network.node_cidr or "10.0.0.0/16" }}"
  nodes = merge(
    { for i in range({{ spec.topology.control_planes }}) : "${local.name}-cp-${i + 1}" => { role = "control-plane", size = "{{ tofu.cp_size }}", disk = 40 } },
    { for i in range({{ spec.topology.workers }}) : "${local.name}-worker-${i + 1}" => { role = "worker", size = "{{ tofu.worker_size }}", disk = 60 } },
  )
  cp_names = [for k, v in local.nodes : k if v.role == "control-plane"]
}

resource "azurerm_resource_group" "rg" {
  name     = local.name
  location = local.location
  tags     = { cluster = local.name, managed-by = "kubernet-wizard" }
}

resource "azurerm_virtual_network" "net" {
  name                = local.name
  resource_group_name = azurerm_resource_group.rg.name
  location            = local.location
  address_space       = [local.vnet_cidr]
}

resource "azurerm_subnet" "nodes" {
  name                 = "nodes"
  resource_group_name  = azurerm_resource_group.rg.name
  virtual_network_name = azurerm_virtual_network.net.name
  address_prefixes     = [cidrsubnet(local.vnet_cidr, 8, 1)]
}

resource "azurerm_public_ip" "node" {
  for_each            = local.nodes
  name                = each.key
  resource_group_name = azurerm_resource_group.rg.name
  location            = local.location
  allocation_method   = "Static"
  sku                 = "Standard"
}

# VNet and Azure LB probe traffic are allowed by the default NSG rules.
resource "azurerm_network_security_group" "nodes" {
  name                = "${local.name}-nodes"
  resource_group_name = azurerm_resource_group.rg.name
  location            = local.location

  security_rule {
    name                       = "ssh"
    priority                   = 100
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "22"
    source_address_prefixes    = var.admin_cidrs
    destination_address_prefix = "*"
  }
  # Nodes reach the API load balancer from their public IPs.
  security_rule {
    name                       = "kube-api"
    priority                   = 110
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_ranges    = [for p in local.lb_ports : tostring(p)]
    source_address_prefixes    = distinct(concat(var.admin_cidrs, [for ip in azurerm_public_ip.node : "${ip.ip_address}/32"]))
    destination_address_prefix = "*"
  }
  security_rule {
    name                       = "ingress"
    priority                   = 120
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_ranges    = ["80", "443"]
    source_address_prefix      = "*"
    destination_address_prefix = "*"
  }
}

resource "azurerm_subnet_network_security_group_association" "nodes" {
  subnet_id                 = azurerm_subnet.nodes.id
  network_security_group_id = azurerm_network_security_group.nodes.id
}

resource "azurerm_network_interface" "node" {
  for_each              = local.nodes
  name                  = each.key
  resource_group_name   = azurerm_resource_group.rg.name
  location              = local.location
  ip_forwarding_enabled = true
  ip_configuration {
    name                          = "primary"
    subnet_id                     = azurerm_subnet.nodes.id
    private_ip_address_allocation = "Dynamic"
    public_ip_address_id          = azurerm_public_ip.node[each.key].id
  }
}

resource "azurerm_linux_virtual_machine" "node" {
  for_each              = local.nodes
  name                  = each.key
  resource_group_name   = azurerm_resource_group.rg.name
  location              = local.location
  size                  = each.value.size
  admin_username        = "kw"
  network_interface_ids = [azurerm_network_interface.node[each.key].id]
  tags                  = { cluster = local.name, role = each.value.role }
  admin_ssh_key {
    username   = "kw"
    public_key = file(pathexpand(var.ssh_public_key))
  }
  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "StandardSSD_LRS"
    disk_size_gb         = each.value.disk
  }
  source_image_reference {
    publisher = local.image[0]
    offer     = local.image[1]
    sku       = local.image[2]
    version   = local.image[3]
  }
}
{% if spec.endpoint.mode == "cloud_lb" %}
resource "azurerm_public_ip" "api" {
  name                = "${local.name}-api"
  resource_group_name = azurerm_resource_group.rg.name
  location            = local.location
  allocation_method   = "Static"
  sku                 = "Standard"
}

resource "azurerm_lb" "api" {
  name                = "${local.name}-api"
  resource_group_name = azurerm_resource_group.rg.name
  location            = local.location
  sku                 = "Standard"
  frontend_ip_configuration {
    name                 = "api"
    public_ip_address_id = azurerm_public_ip.api.id
  }
}

resource "azurerm_lb_backend_address_pool" "cp" {
  name            = "control-plane"
  loadbalancer_id = azurerm_lb.api.id
}

resource "azurerm_network_interface_backend_address_pool_association" "cp" {
  for_each                = toset(local.cp_names)
  network_interface_id    = azurerm_network_interface.node[each.key].id
  ip_configuration_name   = "primary"
  backend_address_pool_id = azurerm_lb_backend_address_pool.cp.id
}

resource "azurerm_lb_probe" "api" {
  for_each        = toset([for p in local.lb_ports : tostring(p)])
  name            = "tcp-${each.value}"
  loadbalancer_id = azurerm_lb.api.id
  protocol        = "Tcp"
  port            = tonumber(each.value)
}

resource "azurerm_lb_rule" "api" {
  for_each                       = azurerm_lb_probe.api
  name                           = "tcp-${each.key}"
  loadbalancer_id                = azurerm_lb.api.id
  protocol                       = "Tcp"
  frontend_port                  = tonumber(each.key)
  backend_port                   = tonumber(each.key)
  frontend_ip_configuration_name = "api"
  backend_address_pool_ids       = [azurerm_lb_backend_address_pool.cp.id]
  probe_id                       = each.value.id
  # Nodes keep outbound access through their own public IPs.
  disable_outbound_snat = true
}
{% endif %}
resource "local_file" "inventory" {
  filename        = "${path.module}/../../ansible/inventory.yml"
  file_permission = "0644"
  content = yamlencode({
    all = {
      {%- if spec.endpoint.mode == "cloud_lb" %}
      vars = { kw_endpoint_host = azurerm_public_ip.api.ip_address }
      {%- endif %}
      children = {
        k8s_cluster = {
          children = {
            control_plane = { hosts = { for k, v in local.nodes : k => { ansible_host = azurerm_public_ip.node[k].ip_address, ansible_user = "kw" } if v.role == "control-plane" } }
            workers       = { hosts = { for k, v in local.nodes : k => { ansible_host = azurerm_public_ip.node[k].ip_address, ansible_user = "kw" } if v.role == "worker" } }
          }
        }
      }
    }
  })
  depends_on = [azurerm_linux_virtual_machine.node]
}

output "control_planes" {
  value = { for k in local.cp_names : k => azurerm_public_ip.node[k].ip_address }
}
{% if spec.endpoint.mode == "cloud_lb" %}
output "api_endpoint" {
  value = azurerm_public_ip.api.ip_address
}
{% endif %}

# Generated by kubernet-wizard: full cluster bootstrap.
# Run: ansible-playbook site.yml
- name: Prepare all nodes
  hosts: k8s_cluster
  become: true
  roles:
    - prereq
    - tuning
{%- if not distro.bundled_runtime %}
    - containerd
{%- endif %}
{%- if spec.endpoint.mode == "dns" %}
    - cp_endpoint_dns
{%- endif %}

- name: Bootstrap first control plane
  hosts: control_plane[0]
  become: true
  vars:
    kw_first_cp: true
  roles:
{%- if spec.endpoint.mode == "keepalived_haproxy" %}
    - cp_endpoint_keepalived
{%- endif %}
{%- if spec.endpoint.mode == "kube_vip" and distro.static_pods_dir %}
    - cp_endpoint_kubevip
{%- endif %}
    - {{ distro.role }}
{%- if spec.endpoint.mode == "kube_vip" and not distro.static_pods_dir %}
    - cp_endpoint_kubevip
{%- endif %}

- name: Join remaining control planes
  hosts: control_plane[1:]
  become: true
  serial: 1
  vars:
    kw_first_cp: false
  roles:
{%- if spec.endpoint.mode == "keepalived_haproxy" %}
    - cp_endpoint_keepalived
{%- endif %}
{%- if spec.endpoint.mode == "kube_vip" and distro.static_pods_dir %}
    - cp_endpoint_kubevip
{%- endif %}
    - {{ distro.role }}

- name: Join workers
  hosts: workers
  become: true
  roles:
    - {{ distro.role }}

- name: Cluster add-ons
  hosts: control_plane[0]
  become: true
  roles:
    - helm_bootstrap
{%- for r in addon_roles %}
    - {{ r }}
{%- endfor %}

- name: Fetch kubeconfig
  hosts: control_plane[0]
  become: true
  roles:
    - kubeconfig

apiVersion: v1
kind: Pod
metadata:
  name: kube-vip
  namespace: kube-system
spec:
  hostNetwork: true
  containers:
    - name: kube-vip
      image: {{ kw_kube_vip_image }}
      args: ["manager"]
      env: {{ kw_kube_vip_env | to_json }}
      securityContext:
        capabilities:
          add: [NET_ADMIN, NET_RAW]
      resources:
        requests: { cpu: 10m, memory: 24Mi }
        limits: { memory: 64Mi }
      volumeMounts:
        - { name: kubeconfig, mountPath: /etc/kubernetes/admin.conf }
  volumes:
    - name: kubeconfig
      hostPath:
        path: "/etc/kubernetes/{{ 'super-admin.conf' if (kw_first_cp | default(false)) and not kw_vip_joined.stat.exists else 'admin.conf' }}"

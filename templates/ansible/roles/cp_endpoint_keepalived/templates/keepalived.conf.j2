vrrp_script chk_haproxy {
  script "/usr/bin/killall -0 haproxy"
  interval 2
  weight 2
}
vrrp_instance KW_API {
  state {{ 'MASTER' if inventory_hostname == groups['control_plane'][0] else 'BACKUP' }}
  interface {{ kw_vip_interface | default(ansible_default_ipv4.interface, true) }}
  virtual_router_id 51
  priority {{ 150 - groups['control_plane'].index(inventory_hostname) * 10 }}
  advert_int 1
  authentication {
    auth_type PASS
    auth_pass {{ kw_cluster_name | hash('md5') | truncate(8, True, '') }}
  }
  virtual_ipaddress {
    {{ kw_vip }}
  }
  track_script {
    chk_haproxy
  }
}

# Generated by kubernet-wizard: add control planes to reach HA.
# Inventory must already list the new control planes (kw upgrade-ha does this).
- name: Prepare new control planes
  hosts: control_plane[1:]
  become: true
  roles:
    - prereq
    - tuning
{%- if not distro.bundled_runtime %}
    - containerd
{%- endif %}

- name: Verify endpoint before joining
  hosts: control_plane[0]
  become: true
  tasks:
    - name: API reachable through stable endpoint
      ansible.builtin.uri:
        url: "https://{{ '{{' }} kw_endpoint_host {{ '}}' }}:{{ '{{' }} kw_api_port {{ '}}' }}/readyz"
        validate_certs: false
        status_code: [200, 401, 403]

- name: Join new control planes one by one
  hosts: control_plane[1:]
  become: true
  serial: 1
  vars:
    kw_first_cp: false
  roles:
{%- if spec.endpoint.mode == "keepalived_haproxy" %}
    - cp_endpoint_keepalived
{%- endif %}
{%- if spec.endpoint.mode == "kube_vip" and distro.static_pods_dir %}
    - cp_endpoint_kubevip
{%- endif %}
    - {{ distro.role }}

- name: Verify control planes
  hosts: control_plane[0]
  become: true
  tasks:
    - name: Wait until all control-plane nodes are Ready
      ansible.builtin.command: >-
        {{ '{{' }} kw_kubectl {{ '}}' }} --kubeconfig {{ '{{' }} kw_kubeconfig {{ '}}' }}
        wait --for=condition=Ready node -l node-role.kubernetes.io/control-plane --timeout=600s
      changed_when: false

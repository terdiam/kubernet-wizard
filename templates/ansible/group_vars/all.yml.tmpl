# Generated by kubernet-wizard from cluster.yaml — edit cluster.yaml, then regenerate.
kw_cluster_name: {{ spec.name }}
kw_distro: {{ distro.id }}
kw_version: "{{ spec.distro.version }}"
kw_os_family: {{ os_family }}
kw_kubeconfig: {{ distro.kubeconfig }}
kw_kubectl: {{ distro.kubectl }}
kw_manifests_dir: {{ distro.manifests_dir or "" }}
kw_static_pods_dir: {{ distro.static_pods_dir or "" }}
kw_ha: {{ "true" if spec.topology.ha else "false" }}
kw_workers_count: {{ spec.topology.workers }}

# Control-plane endpoint (stable from day one so single CP can become HA)
kw_endpoint_mode: {{ spec.endpoint.mode }}
{% if endpoint_host %}kw_endpoint_host: "{{ endpoint_host }}"
{% else %}# kw_endpoint_host is set by OpenTofu inventory (cloud LB address)
{% endif %}kw_api_port: {{ api_port }}
kw_vip: "{{ spec.endpoint.vip or "" }}"
kw_vip_interface: "{{ spec.endpoint.interface or "" }}"
kw_tls_sans_static: {{ tls_sans | tojson }}
kw_tls_sans: "{{ '{{' }} (kw_tls_sans_static + [kw_endpoint_host]) | unique {{ '}}' }}"

# Service load balancer
kw_service_lb: {{ spec.service_lb.kind }}
kw_lb_advertisement: {{ spec.service_lb.advertisement }}
kw_lb_pool: "{{ spec.service_lb.pool or "" }}"

# Network
kw_cni: {{ spec.network.cni }}
kw_pod_cidr: "{{ spec.network.pod_cidr }}"
kw_service_cidr: "{{ spec.network.service_cidr }}"
kw_cluster_dns: "{{ cluster_dns }}"
kw_cluster_domain: {{ spec.network.cluster_domain }}
kw_kube_proxy: {{ spec.network.kube_proxy }}
kw_mtu: {{ spec.network.mtu or 0 }}

# Ingress (empty chart = none / bundled by distro)
kw_ingress: {{ spec.ingress }}
kw_ingress_chart: {{ ingress_chart | tojson }}

# Add-ons installed by Helm (empty when GitOps manages them)
kw_addons: {{ helm_addons | tojson }}

# GitOps
kw_gitops_tool: {{ spec.gitops.tool }}
kw_gitops_repo: "{{ spec.gitops.repo_url }}"
kw_gitops_branch: "{{ spec.gitops.branch }}"
kw_gitops_path: "{{ gitops_path }}"

# Tuning profile: {{ spec.tuning.profile }}
kw_tuning_profile: {{ spec.tuning.profile }}
kw_sysctl: {{ sysctl | tojson }}
kw_disable_services: {{ disable_services | tojson }}
kw_kubelet:
  system_reserved: "{{ kubelet.system_reserved }}"
  kube_reserved: "{{ kubelet.kube_reserved }}"
  eviction_hard: "{{ kubelet.eviction_hard }}"
  max_pods: {{ kubelet.max_pods }}
  image_gc_high: {{ kubelet.image_gc_high }}
  image_gc_low: {{ kubelet.image_gc_low }}
  cpu_manager_policy: {{ kubelet.cpu_manager_policy }}
  serialize_image_pulls: false
